# ── 티스토리 반자동 발행 ──────────────────────────────
# myblog.tistory.com 이면 myblog 만 적습니다
TISTORY_BLOG=

# ── 이미지 생성 API ───────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── 자료조사 · 검증 채널 ──────────────────────────────
# 네이버 검색 API (뉴스/블로그/백과) — developers.naver.com, 일 25,000건 무료
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 한국은행 ECOS (금리·환율·물가) — ecos.bok.or.kr/api, 무료
ECOS_API_KEY=

# 금융감독원 DART (공시·재무제표) — opendart.fss.or.kr, 무료
DART_API_KEY=

# 공공데이터포털 (각종 통계) — data.go.kr, 무료
DATA_GO_KR_KEY=

# 해외 거시지표 FRED — fred.stlouisfed.org/docs/api, 무료
FRED_API_KEY=

# 웹 검색 API (택1, 선택사항)
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# ── 재테크 블로그 ─────────────────────────────────────
# 공공데이터포털 — 국토부 아파트 실거래가 (PublicDataReader)
#   data.go.kr → '국토교통부 아파트매매 실거래가' 활용신청
PUBLIC_DATA_API_KEY=

# ── 테크/패션 블로그 ──────────────────────────────────
# 유튜브 리뷰 영상 검색 — console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=

# 레딧 커뮤니티 반응 (r/android, r/hardware, r/malefashionadvice 등)
#   reddit.com/prefs/apps → script 타입으로 앱 생성
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=blog-automation/1.0
